{
  "name": "ai-booster-kit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "check:docs": "node scripts/check-doc-links.mjs",
    "package:booster": "node scripts/package-booster-plugin.mjs",
    "check:booster-package": "node scripts/package-booster-plugin.mjs --check",
    "cli": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.2"
  }
}
