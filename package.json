{
  "name": "agent-agnostic-sync-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "check:docs": "node --experimental-strip-types scripts/check-doc-links.mjs",
    "check:mappers": "node scripts/check-mapper-freshness.mjs",
    "test": "npm run build && node --test dist/test/*.test.js dist/test/conformance/*.test.js dist/test/performance/*.test.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.2"
  }
}
